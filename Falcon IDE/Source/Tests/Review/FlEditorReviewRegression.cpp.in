uint32_t g_deleteEntity = UINT32_MAX, g_currentEntity = UINT32_MAX;
bool g_modalDelete = false, g_confirmDelete = false;
int g_projectDeletes = 0;
std::vector<uint32_t> g_drawnEntities;
using ImGuiTreeNodeFlags = int;
constexpr int ImGuiTreeNodeFlags_OpenOnArrow = 1, ImGuiTreeNodeFlags_OpenOnDoubleClick = 2,
    ImGuiTreeNodeFlags_Selected = 4, ImGuiTreeNodeFlags_Leaf = 8;
constexpr int ImGuiMouseButton_Left = 0, ImGuiMouseButton_Right = 1, ImGuiDragDropFlags_SourceAllowNullID = 1;
struct ImGuiPayload { void* Data = nullptr; };
namespace ImGui {
    bool TreeNodeEx(void* id, int, const char*, ...) { g_currentEntity = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(id)); g_drawnEntities.push_back(g_currentEntity); return true; }
    bool IsItemActive() { return false; }
    bool IsMouseDragging(int) { return false; }
    bool IsItemClicked(int) { return false; }
    bool BeginDragDropSource(int) { return false; }
    void SetDragDropPayload(const char*, const void*, size_t) {}
    void EndDragDropSource() {}
    bool BeginDragDropTarget() { return false; }
    const ImGuiPayload* AcceptDragDropPayload(const char*) { return nullptr; }
    void EndDragDropTarget() {}
    bool BeginPopupContextItem() { return g_currentEntity == g_deleteEntity; }
    bool MenuItem(const char* name) { return std::string(name) == "Delete Entity"; }
    void Text(const char*, ...) {}
    void TreePop() {}
    void EndPopup() {}
    void OpenPopup(const char*) {}
    bool BeginPopup(const char* name) { return g_modalDelete && std::string(name) == "DeleteProjectPopup"; }
    void InputText(const char*, std::string*) {}
    bool Button(const char* name) { return g_confirmDelete && std::string(name) == "Delete"; }
    void CloseCurrentPopup() {}
    void SameLine() {}
    void Separator() {}
}
struct FlFileWatcher { bool RemDirectory(const std::filesystem::path&) { ++g_projectDeletes; return true; } };

struct TransformComponent { uint32_t m_parent = UINT32_MAX; std::vector<uint32_t> m_children; };
struct NameComponent { std::string m_name; };
struct FlEntityComponentSystemKernel {
    std::unordered_map<uint32_t, TransformComponent> entities;
    static FlEntityComponentSystemKernel& Instance() { static FlEntityComponentSystemKernel value; return value; }
    void* GetComponent(const std::string& type, uint32_t id) { auto it = entities.find(id); return type != "Transform" || it == entities.end() ? nullptr : &it->second; }
    bool IsActive(uint32_t id) { return entities.contains(id); }
    void DestroyEntity(uint32_t id) { entities.erase(id); }
    void ClearComponent(const std::string&) { ++g_projectDeletes; }
};
struct FlECSInspectorAndHierarchy {
    uint32_t m_selectedEntityId = UINT32_MAX;
    void RefreshEntityList() {}
    void SetParent(uint32_t, uint32_t);
    void DeleteEntityRecursive(uint32_t);
    void RenderEntityNode(uint32_t);
    void CreatePrefab(uint32_t) {}
    void InstantiatePrefab(const std::string&) {}
    bool OpenFileDialog(std::string&, const std::string&, const char*) { return false; }
};
@SetParent@
@DeleteEntityRecursive@
