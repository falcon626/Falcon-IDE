class FlGuid {
public:
    std::string ToString() const { static int serial = 0; return "test-guid-" + std::to_string(++serial); }
};
namespace Str {
    std::string ReplaceString(std::string text, const std::string& from, const std::string& to) {
        for (size_t pos = 0; (pos = text.find(from, pos)) != std::string::npos; pos += to.size()) text.replace(pos, from.size(), to);
        return text;
    }
}
