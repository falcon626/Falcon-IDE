struct TestMeta {
    std::list<std::string> files;
    bool changed = true;
    bool failReset = false;
    int resets = 0;
    auto GetAllFilePaths() { return files; }
    bool IsAssetChanged(const std::filesystem::path&) { return changed; }
    bool ResetAssetChangeFlag(const std::filesystem::path& path, std::filesystem::file_time_type expected) {
        if (failReset || std::filesystem::last_write_time(path) != expected) return false;
        changed = false; ++resets; return true;
    }
};
struct TestTicker { bool tick() { return true; } };
class FlScriptModuleEditor {
public:
    std::unique_ptr<FlVisualStudioProjectManager> m_manager = std::make_unique<FlVisualStudioProjectManager>();
    std::unique_ptr<TestMeta> m_meta = std::make_unique<TestMeta>();
    std::unique_ptr<TestTicker> m_upTicker = std::make_unique<TestTicker>();
    std::filesystem::path m_targetDir = "DynamicLib";
    FlTerminalEditor& m_terminal;
    std::list<std::string> m_codeFiles, m_changerdCodeFiles;
    struct PendingBuild { std::future<bool> completion; std::filesystem::file_time_type sourceWriteTime; };
    std::unordered_map<std::string, PendingBuild> m_pendingBuilds;
    std::unordered_map<std::string, std::filesystem::file_time_type> m_failedBuilds;
    struct PopupRequest { enum class Type { Create, Delete } type; std::string targetProjectName; };
    std::optional<PopupRequest> m_pendingPopup;
    std::string m_newProjectName;
    explicit FlScriptModuleEditor(FlTerminalEditor& terminal) : m_terminal(terminal) {}
    void ChangedFilesRefresh() noexcept;
    void Update() noexcept;
    bool CanDeleteProject(const std::string&) const noexcept;
    void RenderPopup();
};
@ChangedFilesRefresh@
@Update@
@CanDeleteProject@
@RenderPopup@

void FinishBuild(FlScriptModuleEditor& editor) {
    assert(editor.m_pendingBuilds.size() == 1);
    assert(editor.m_pendingBuilds.begin()->second.completion.wait_for(std::chrono::seconds(5)) == std::future_status::ready);
    editor.Update();
}

int main(int argc, char** argv) {
    assert(argc == 2);
    if (std::string(argv[1]) == "--wait") { Sleep(60000); return 0; }
    std::filesystem::current_path(argv[1]);
    FlVisualStudioProjectManager manager;
    for (const auto* bad : {"", "../Escape", "C:\\Escape", "Two Words", "a&b", "9Test", "CON", "com1", "Lpt9", "_Reserved", "Has__Reserved"})
        assert(!manager.IsValidProjectName(bad));
    assert(manager.IsValidProjectName("Safe_Project2"));
    assert(!manager.CreateNewProject("../Escape", "DynamicLib"));
    assert(!std::filesystem::exists("DynamicLib"));
    std::filesystem::create_directories("ScriptModule/Existing");
    std::ofstream("ScriptModule/Existing/Existing.cxx") << "keep source";
    assert(!manager.CreateNewProject("Existing", "DynamicLib"));
    assert(!std::filesystem::exists("DynamicLib/Existing"));
    std::ifstream source("ScriptModule/Existing/Existing.cxx");
    std::string text; std::getline(source, text); assert(text == "keep source"); source.close();
    std::filesystem::create_directories("DynamicLib/Partial");
    assert(!manager.CreateNewProject("Partial", "DynamicLib"));
    assert(!std::filesystem::exists("ScriptModule/Partial"));
    const std::filesystem::path samples = "Src/Framework/System/VisualStudioManager/Sample";
    std::filesystem::create_directories(samples);
    std::ofstream(samples / "Template.cxx.flsample") << "struct #ProjectName#Component {};";
    std::ofstream(samples / "Template.vcxproj.flsample") << "<Project Name=\"#ProjectName#\" Guid=\"#GUID#\"/>";
    std::ofstream(samples / "Template.vcxproj.filters.flsample") << "<Filter Name=\"#ProjectName#\" Guid=\"#GUID#\"/>";
    std::ofstream("Test.slnx") << "<Solution/>";
    assert(manager.CreateNewProject("Fresh", "DynamicLib"));
    assert(std::filesystem::exists("ScriptModule/Fresh/Fresh.cxx"));
    std::vector<uint8_t> originalSolution, restoredSolution;
    assert(FlAssetProtector::ReadFileBinary("Test.slnx", originalSolution));
    const auto lockedSolution = CreateFileW(L"Test.slnx", GENERIC_READ, FILE_SHARE_READ, nullptr,
        OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
    assert(lockedSolution != INVALID_HANDLE_VALUE);
    assert(!manager.CreateNewProject("Retry", "DynamicLib"));
    assert(!std::filesystem::exists("DynamicLib/Retry") && !std::filesystem::exists("ScriptModule/Retry"));
    std::filesystem::path failedStage;
    for (const auto& entry : std::filesystem::directory_iterator("DynamicLib"))
        if (entry.path().filename().string().starts_with(".FlCreate-")) failedStage = entry.path();
    assert(!failedStage.empty());
    assert(std::filesystem::exists(failedStage / "Script/Retry.cxx"));
    std::ofstream(failedStage / "user-added.txt") << "keep user file";
    CloseHandle(lockedSolution);
    assert(FlAssetProtector::ReadFileBinary("Test.slnx", restoredSolution) && restoredSolution == originalSolution);
    assert(manager.CreateNewProject("Retry", "DynamicLib"));
    assert(std::filesystem::exists("ScriptModule/Retry/Retry.cxx"));
    assert(std::filesystem::exists(failedStage / "user-added.txt"));
    const auto buildCommand = manager.CreateDetectedBuildCommand("Space Path/Test.vcxproj", "Debug", "Win32", "Build");
    assert(!buildCommand.empty());
    assert(buildCommand.find("vcvarsall.bat\" x86 && msbuild \"") != std::string::npos);
    assert(buildCommand.find(" /p:Configuration=Debug /p:Platform=Win32") != std::string::npos);

    auto& entities = FlEntityComponentSystemKernel::Instance().entities;
    entities[1] = {UINT32_MAX, {2}}; entities[2] = {1, {}}; entities[3] = {UINT32_MAX, {}};
    FlECSInspectorAndHierarchy hierarchy;
    hierarchy.SetParent(1, 2);
    assert(entities.at(1).m_parent == UINT32_MAX && entities.at(2).m_parent == 1);
    hierarchy.SetParent(2, 3);
    assert(entities.at(2).m_parent == 3 && entities.at(1).m_children.empty());
    entities.at(2).m_parent = 3; entities.at(3).m_parent = 2;
    hierarchy.SetParent(1, 2);
    assert(entities.at(1).m_parent == UINT32_MAX);
    entities.clear();
    entities[1] = {UINT32_MAX, {2, 3, 4}};
    for (uint32_t id : {2u, 3u, 4u}) entities[id] = {1, {}};
    hierarchy.DeleteEntityRecursive(1);
    assert(entities.empty());
    entities[1] = {UINT32_MAX, {2, 3, 4}};
    for (uint32_t id : {2u, 3u, 4u}) entities[id] = {1, {}};
    g_deleteEntity = 2;
    hierarchy.RenderEntityNode(1);
    assert(!entities.contains(2) && entities.contains(3) && entities.contains(4));
    assert((g_drawnEntities == std::vector<uint32_t>{1, 2, 3, 4}));
    g_deleteEntity = UINT32_MAX;

    FlTerminalEditor terminal;
    auto ok = terminal.ExecuteCommand("exit /b 0"); assert(ok.get());
    auto fail = terminal.ExecuteCommand("exit /b 7"); assert(!fail.get());
    auto cls = terminal.ExecuteCommand("cls"); assert(cls.get());
    auto cd = terminal.ExecuteCommand("cd directory-that-does-not-exist"); assert(!cd.get());
    assert(!terminal.IsRunning());

    std::filesystem::create_directories("ScriptModule/BuildTest");
    const std::string file = "ScriptModule/BuildTest/BuildTest.cxx";
    std::ofstream(file) << "version one";
    FlScriptModuleEditor editor(terminal);
    editor.m_meta->files = {file};
    editor.Update();
    assert(editor.m_meta->changed && editor.m_meta->resets == 0);
    FinishBuild(editor);
    assert(!editor.m_meta->changed && editor.m_meta->resets == 1);

    editor.m_meta->changed = true; g_buildCommand = "exit /b 7";
    editor.Update(); FinishBuild(editor);
    assert(editor.m_meta->changed && editor.m_failedBuilds.contains(file));
    editor.Update(); assert(editor.m_pendingBuilds.empty());
    editor.m_failedBuilds.clear(); g_buildCommand = "exit /b 0";
    editor.Update(); FinishBuild(editor); assert(!editor.m_meta->changed);

    editor.m_meta->changed = true; editor.Update();
    const auto oldTime = std::filesystem::last_write_time(file);
    std::filesystem::last_write_time(file, oldTime + std::chrono::seconds(1));
    const auto oldResets = editor.m_meta->resets;
    FinishBuild(editor);
    assert(editor.m_meta->changed && editor.m_meta->resets == oldResets);
    FinishBuild(editor); assert(!editor.m_meta->changed);

    editor.m_meta->changed = true; editor.m_meta->failReset = true;
    editor.Update(); FinishBuild(editor);
    assert(editor.m_meta->changed && editor.m_failedBuilds.contains(file));
    editor.m_failedBuilds.clear(); editor.m_meta->failReset = false; g_forming = false;
    editor.Update(); assert(editor.m_pendingBuilds.empty() && editor.m_meta->changed);
    editor.m_pendingPopup = FlScriptModuleEditor::PopupRequest{ FlScriptModuleEditor::PopupRequest::Type::Delete, "BuildTest" };
    g_forming = true; editor.m_failedBuilds.clear();
    g_modalDelete = true; g_confirmDelete = true;
    editor.Update();
    editor.RenderPopup();
    assert(g_projectDeletes == 0 && editor.m_pendingPopup.has_value());
    FinishBuild(editor);
    editor.RenderPopup();
    assert(g_projectDeletes > 0 && !editor.m_pendingPopup.has_value());
    g_modalDelete = false; g_confirmDelete = false;

    STARTUPINFOW independentStartup{ sizeof(STARTUPINFOW) };
    PROCESS_INFORMATION independent{};
    std::wstring thisExe(32768, L'\0');
    thisExe.resize(GetModuleFileNameW(nullptr, thisExe.data(), static_cast<DWORD>(thisExe.size())));
    std::wstring independentCommand = L"\"" + thisExe + L"\" --wait";
    assert(CreateProcessW(thisExe.c_str(), independentCommand.data(), nullptr, nullptr, FALSE,
        CREATE_NO_WINDOW, nullptr, nullptr, &independentStartup, &independent));
    auto ownedTerminal = std::make_unique<FlTerminalEditor>();
    const auto ownedCommand = "\"" + wide_to_ansi(thisExe) + "\" --wait";
    auto longCommand = ownedTerminal->ExecuteCommand(ownedCommand.c_str());
    auto queuedCommand = ownedTerminal->ExecuteCommand("exit /b 0");
    bool processTreeStarted = false;
    for (int attempt = 0; attempt < 200; ++attempt) {
        {
            std::lock_guard lock(ownedTerminal->m_processMutex);
            JOBOBJECT_BASIC_ACCOUNTING_INFORMATION accounting{};
            if (ownedTerminal->m_processJob && QueryInformationJobObject(ownedTerminal->m_processJob,
                JobObjectBasicAccountingInformation, &accounting, sizeof(accounting), nullptr))
                processTreeStarted = accounting.ActiveProcesses >= 2;
        }
        if (processTreeStarted) break;
        std::this_thread::sleep_for(std::chrono::milliseconds(10));
    }
    assert(processTreeStarted);
    const auto shutdownStart = std::chrono::steady_clock::now();
    ownedTerminal.reset();
    assert(std::chrono::steady_clock::now() - shutdownStart < std::chrono::seconds(3));
    std::cout << "Owned process tree shutdown: " << std::chrono::duration_cast<std::chrono::milliseconds>(
        std::chrono::steady_clock::now() - shutdownStart).count() << " ms\n";
    assert(!longCommand.get() && !queuedCommand.get());
    assert(WaitForSingleObject(independent.hProcess, 0) == WAIT_TIMEOUT);
    TerminateProcess(independent.hProcess, 1);
    WaitForSingleObject(independent.hProcess, 3000);
    CloseHandle(independent.hThread);
    CloseHandle(independent.hProcess);
    return 0;
}
