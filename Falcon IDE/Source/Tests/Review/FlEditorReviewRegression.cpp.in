bool g_forming = true;
std::string g_buildCommand = "exit /b 0";
struct FlVisualStudioProjectManager {
    std::filesystem::path m_solutionPath = "Test.slnx";
    static bool IsValidProjectName(const std::string&) noexcept;
    bool CreateNewProject(const std::string&, const std::filesystem::path&) noexcept;
    bool CreateSourceFiles(const std::filesystem::path&, const std::string&, const std::filesystem::path&) noexcept;
    bool CreateVcxproj(const std::filesystem::path&, const std::string&) noexcept;
    bool CreateFilters(const std::filesystem::path&, const std::string&) noexcept;
    bool AddProjectToSolution(const std::filesystem::path&, const std::filesystem::path&, const std::string&) { return true; }
    bool AddProjectToSolutionSlnx(const std::filesystem::path&, const std::filesystem::path&) noexcept;
    bool RemoveProjectFromSolution(const std::filesystem::path&) { return true; }
    bool FormingModule(const std::filesystem::path&, const std::filesystem::path&) { return g_forming; }
    static std::string CreateBuildCommand(const std::filesystem::path&, const std::string&, const std::string&, const std::string&) { return g_buildCommand; }
    static std::string CreateDetectedBuildCommand(const std::filesystem::path&, const std::string&, const std::string&, const std::string&);
};
